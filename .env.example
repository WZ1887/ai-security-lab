APP_ENV=dev
APP_NAME=MCP-Guard
APP_VERSION=0.1.0

DATABASE_URL=postgresql+psycopg2://mcp:mcp_dev_password@localhost:5432/mcp_guard

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED=nomic-embed-text

# 至少 32 字节；生成方式：python -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET=change_me_change_me_change_me_change_me
JWT_ALG=HS256
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# G5 审批令牌
APPROVAL_TOKEN_SECRET=mcp-guard-approval-secret-change-me-please
APPROVAL_TOKEN_TTL_SECONDS=300

# 认证
ALLOW_DEV_TOKEN=false
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
MFA_ISSUER=MCP-Guard

# 自注册（自注册账号只能拿到最低权限，特权角色由管理员授予）
ALLOW_SELF_REGISTRATION=true
DEFAULT_SIGNUP_TENANT=tenant_public
VERIFICATION_TOKEN_TTL_SECONDS=86400
REGISTER_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=900
PASSWORD_MIN_LENGTH=8

# 记忆（只存事实）
MEMORY_RECALL_LIMIT=20

# G5 沙箱（留空 = 仓库根目录下的 sandbox_root）
SANDBOX_ROOT=
SANDBOX_MAX_ARG_CHARS=8192
